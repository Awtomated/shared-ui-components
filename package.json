{
  "name": "@awtomated/shared-ui",
  "version": "0.1.0",
  "description": "Shared, framework-agnostic UI components (FilterBar, Log Time / mention editor) reused across Awtomated host app and micro-frontends.",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "babel src -d dist --copy-files --ignore \"src/**/*.test.js\"",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@mui/material": ">=5.0.0",
    "@mui/icons-material": ">=5.0.0",
    "@tiptap/core": "^2.0.0",
    "@tiptap/pm": "^2.0.0",
    "@tiptap/react": "^2.0.0",
    "@tiptap/starter-kit": "^2.0.0",
    "@tiptap/suggestion": "^2.0.0",
    "@tiptap/extension-placeholder": "^2.0.0",
    "@tiptap/extension-mention": "^2.0.0",
    "react-window": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": { "optional": true },
    "@tiptap/pm": { "optional": true },
    "@tiptap/react": { "optional": true },
    "@tiptap/starter-kit": { "optional": true },
    "@tiptap/suggestion": { "optional": true },
    "@tiptap/extension-placeholder": { "optional": true },
    "@tiptap/extension-mention": { "optional": true },
    "react-window": { "optional": true }
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0"
  }
}
